# Aegis IAST control-plane API — local development configuration.
# Copy to .env and adjust. Never commit .env.

AEGIS_ENVIRONMENT=local
AEGIS_DEBUG=true
AEGIS_LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------------
# The Docker compose stack publishes PostgreSQL on 5432. A locally installed
# PostgreSQL commonly uses a different port — adjust to match your instance.
AEGIS_DATABASE_URL=postgresql+asyncpg://aegis:aegis_local_dev@localhost:5432/aegis
AEGIS_DATABASE_POOL_SIZE=10
AEGIS_DATABASE_MAX_OVERFLOW=20
AEGIS_DATABASE_ECHO=false

# Used only by the test suite. The database is created and dropped per session.
AEGIS_TEST_DATABASE_URL=postgresql+asyncpg://aegis:aegis_local_dev@localhost:5432/aegis_test

# --- Redis --------------------------------------------------------------------
AEGIS_REDIS_URL=redis://localhost:6379/0

# --- Security -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
AEGIS_JWT_SECRET=change-me-a-64-byte-random-value-for-local-development-only
AEGIS_JWT_ALGORITHM=HS256
AEGIS_JWT_ISSUER=https://api.aegis.local
AEGIS_ACCESS_TOKEN_TTL_SECONDS=900
AEGIS_REFRESH_TOKEN_TTL_SECONDS=2592000
AEGIS_REFRESH_ROTATION_GRACE_SECONDS=10
AEGIS_MFA_CHALLENGE_TTL_SECONDS=300

# Fernet key used to encrypt TOTP secrets at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AEGIS_SECRET_ENCRYPTION_KEY=

AEGIS_PASSWORD_MIN_LENGTH=12
AEGIS_MAX_FAILED_LOGINS=5
AEGIS_LOCKOUT_BASE_SECONDS=60
AEGIS_LOCKOUT_MAX_SECONDS=3600

# --- Feature flags ------------------------------------------------------------
AEGIS_ALLOW_SELF_SERVICE_SIGNUP=true
AEGIS_REQUIRE_MFA_FOR_PRIVILEGED_ROLES=false
AEGIS_ENFORCE_ROW_LEVEL_SECURITY=true

# --- HTTP ---------------------------------------------------------------------
AEGIS_CORS_ORIGINS=http://localhost:3100
AEGIS_RATE_LIMIT_ANONYMOUS_PER_MINUTE=10
AEGIS_RATE_LIMIT_USER_PER_MINUTE=600
AEGIS_RATE_LIMIT_API_KEY_PER_MINUTE=6000

# --- Observability ------------------------------------------------------------
AEGIS_OTEL_ENABLED=false
AEGIS_OTEL_ENDPOINT=http://localhost:4317
