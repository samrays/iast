# Aegis IAST ingest gateway.

AEGIS_GATEWAY_ENVIRONMENT=local
AEGIS_GATEWAY_LOG_LEVEL=INFO

# --- agent credential verification --------------------------------------------
# Must match the control plane's signing configuration: the API issues the agent
# tokens this service verifies. Use an asymmetric algorithm in production so the
# gateway — the most exposed service in the platform — never holds a signing key.
AEGIS_GATEWAY_JWT_SECRET=
AEGIS_GATEWAY_JWT_ALGORITHM=HS256
AEGIS_GATEWAY_JWT_ISSUER=https://api.aegis.local
# AEGIS_GATEWAY_JWT_PUBLIC_KEY=

# --- ingest -------------------------------------------------------------------
# kafka://broker:9092/runtime-events | file:/var/log/aegis/events.ndjson | memory://
# The in-memory sink discards everything on restart and is refused in production.
AEGIS_GATEWAY_EVENT_SINK=memory://
AEGIS_GATEWAY_MAX_BATCH_BYTES=8388608
AEGIS_GATEWAY_MAX_BATCH_EVENTS=512
# Strict mode fails a whole batch on one malformed event. Useful when developing an
# agent; wrong in production, where it would cost a tenant real findings.
AEGIS_GATEWAY_REJECT_BATCH_ON_INVALID=false

# --- quota --------------------------------------------------------------------
AEGIS_GATEWAY_QUOTA_EVENTS_PER_SECOND=5000
AEGIS_GATEWAY_QUOTA_BURST_MULTIPLIER=10
AEGIS_GATEWAY_DEDUP_CACHE_SIZE=100000
