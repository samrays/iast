# ==============================================================================
# Aegis IAST — Environment Configuration Template (.env)
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env     (Linux/macOS)
#   copy .env.example .env   (Windows CMD)
#   Copy-Item .env.example .env (PowerShell)
# ==============================================================================

# Application Environment
AEGIS_ENVIRONMENT=local
AEGIS_DEBUG=true
AEGIS_LOG_LEVEL=INFO

# --- Database Configuration ---
# Option A: Local SQLite Database (Default for demo & standalone setups)
# Note: For SQLite, Aegis automatically resolves relative paths or demo database:
AEGIS_DATABASE_URL=sqlite+aiosqlite:///./aegis_demo.db
AEGIS_ENFORCE_ROW_LEVEL_SECURITY=false

# Option B: PostgreSQL (Uncomment if using Docker backing services)
# AEGIS_DATABASE_URL=postgresql+asyncpg://aegis:aegis_local_dev@localhost:5433/aegis
# AEGIS_ENFORCE_ROW_LEVEL_SECURITY=true

# --- Security & JWT Settings ---
AEGIS_JWT_SECRET=change-me-a-64-byte-random-value-for-local-development-only
AEGIS_JWT_ALGORITHM=HS256
AEGIS_JWT_ISSUER=https://api.aegis.local

# --- CORS & Web Dashboard ---
AEGIS_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
