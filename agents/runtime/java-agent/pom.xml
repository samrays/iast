<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.aegis</groupId>
  <artifactId>aegis-java-agent</artifactId>
  <version>0.4.0</version>
  <packaging>jar</packaging>
  <name>Aegis IAST Java Agent</name>
  <description>
    Runtime instrumentation agent for the JVM. Loads via -javaagent, tracks taint from
    untrusted sources to security-sensitive sinks, and reports findings with evidence.
  </description>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <bytebuddy.version>1.14.18</bytebuddy.version>
    <junit.version>5.10.2</junit.version>
    <h2.version>2.2.224</h2.version>
    <!--
      Jetty 11 is the last line that targets Java 17 with the jakarta.servlet 5 API. It is a
      test dependency only: the agent never compiles against a servlet API, because the classes
      it instruments live on the application's loader while the runtime they call lives on
      bootstrap, so all servlet matching is by name and all reading is by reflection.
    -->
    <jetty.version>11.0.20</jetty.version>
  </properties>

  <dependencies>
    <!--
      Byte Buddy is the only runtime dependency, and it is shaded below. An agent that
      leaks its own dependencies onto the application classpath is a support nightmare:
      the customer's Byte Buddy version and ours would fight, inside their production
      process.
    -->
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <version>${bytebuddy.version}</version>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy-agent</artifactId>
      <version>${bytebuddy.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- A real JDBC driver, so sink tests exercise a real Statement, not a stub. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
      <scope>test</scope>
    </dependency>
    <!--
      A real servlet container, for the same reason. Servlet instrumentation is exactly the
      kind of code that passes against a hand-written stub and fails against Tomcat, because
      what actually matters — that the request object is a container facade wrapping a
      recycled instance, reached through an interface, on a pooled thread — is precisely what
      a stub does not reproduce.
    -->
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-servlet</artifactId>
      <version>${jetty.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>aegis-agent</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>

      <!--
        The JDK-core instrumentation can only be proven against the packaged jar, because
        bootstrap injection needs a real jar file. Failsafe runs after package for exactly
        that reason.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.2.5</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <systemPropertyVariables>
            <aegis.agent.jar>${project.build.directory}/aegis-agent.jar</aegis.agent.jar>
            <aegis.test.classpath>${project.build.directory}/test-classes</aegis.test.classpath>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>copy-test-deps</id>
            <phase>pre-integration-test</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/it-libs</outputDirectory>
              <includeScope>test</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.3</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <relocations>
                <relocation>
                  <pattern>net.bytebuddy</pattern>
                  <shadedPattern>dev.aegis.shaded.bytebuddy</shadedPattern>
                </relocation>
              </relocations>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Premain-Class>dev.aegis.agent.AegisAgent</Premain-Class>
                    <Agent-Class>dev.aegis.agent.AegisAgent</Agent-Class>
                    <Can-Redefine-Classes>true</Can-Redefine-Classes>
                    <Can-Retransform-Classes>true</Can-Retransform-Classes>
                    <Can-Set-Native-Method-Prefix>true</Can-Set-Native-Method-Prefix>
                    <Implementation-Version>${project.version}</Implementation-Version>
                  </manifestEntries>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
